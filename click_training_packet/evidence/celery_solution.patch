+import enum
+import pytest
+import click
+from click.shell_completion import CompletionItem
+
+
+class Mode(enum.Enum):
+    FAST = "fast-value"
+    SAFE = "safe-value"
+
+
+class StrMode(str, enum.Enum):
+    READ = "read-mode"
+    WRITE = "write-mode"
+
+
+class IntMode(int, enum.Enum):
+    ONE = 1
+    TWO = 2
+
+
+def test_enum_choice_basic():
+    """Test basic enum choice conversion."""
+    choice = click.Choice(Mode)
+    
+    assert choice.convert("FAST", None, None) == Mode.FAST
+    assert choice.convert("SAFE", None, None) == Mode.SAFE
+    
+    with pytest.raises(click.exceptions.BadParameter):
+        choice.convert("INVALID", None, None)
+
+
+def test_enum_choice_uses_name_not_value():
+    """Test that enum choices use .name not .value."""
+    choice = click.Choice(Mode)
+    
+    with pytest.raises(click.exceptions.BadParameter):
+        choice.convert("fast-value", None, None)
+    
+    assert choice.convert("FAST", None, None) == Mode.FAST
+
+
+def test_str_enum_choice():
+    """Test str subclass enum uses .name."""
+    choice = click.Choice(StrMode)
+    
+    assert choice.convert("READ", None, None) == StrMode.READ
+    
+    with pytest.raises(click.exceptions.BadParameter):
+        choice.convert("read-mode", None, None)
+
+
+def test_int_enum_choice():
+    """Test int subclass enum uses .name."""
+    choice = click.Choice(IntMode)
+    
+    assert choice.convert("ONE", None, None) == IntMode.ONE
+    
+    with pytest.raises(click.exceptions.BadParameter):
+        choice.convert("1", None, None)
+
+
+def test_integer_choices():
+    """Test non-string integer choices."""
+    choice = click.Choice([10, 20])
+    
+    assert choice.convert("10", None, None) == 10
+    assert choice.convert("20", None, None) == 20
+    assert choice.convert(10, None, None) == 10
+    assert choice.convert(20, None, None) == 20
+    
+    with pytest.raises(click.exceptions.BadParameter):
+        choice.convert("30", None, None)
+
+
+def test_case_insensitive_unicode():
+    """Test case-insensitive unicode handling."""
+    choice = click.Choice(["Straße", "STRASSE"], case_sensitive=False)
+    
+    assert choice.convert("strasse", None, None) == "Straße"
+    assert choice.convert("STRASSE", None, None) == "Straße"
+    assert choice.convert("Straße", None, None) == "Straße"
+
+
+def test_case_insensitive_enum():
+    """Test case-insensitive enum choice."""
+    choice = click.Choice(Mode, case_sensitive=False)
+    
+    assert choice.convert("fast", None, None) == Mode.FAST
+    assert choice.convert("FAST", None, None) == Mode.FAST
+    assert choice.convert("FaSt", None, None) == Mode.FAST
+
+
+def test_context_normalizer():
+    """Test context token normalizer with Choice."""
+    @click.command()
+    @click.option("--opt", type=click.Choice(["read_only"]))
+    @click.pass_context
+    def cmd(ctx, opt):
+        return opt
+    
+    ctx = click.Context(cmd, token_normalize_func=lambda x: x.replace("-", "_"))
+    choice = click.Choice(["read_only"])
+    
+    assert choice.convert("read-only", None, ctx) == "read_only"
+    assert choice.convert("read_only", None, ctx) == "read_only"
+
+
+def test_metavar_enum():
+    """Test metavar display for enum choices."""
+    choice = click.Choice(Mode)
+    
+    @click.command()
+    @click.argument("mode", type=choice, required=True)
+    def cmd(mode):
+        pass
+    
+    param = cmd.params[0]
+    metavar = choice.get_metavar(param)
+    assert metavar == "{FAST|SAFE}"
+
+
+def test_metavar_integer():
+    """Test metavar display for integer choices."""
+    choice = click.Choice([10, 20])
+    
+    @click.command()
+    @click.option("--num", type=choice)
+    def cmd(num):
+        pass
+    
+    param = cmd.params[0]
+    metavar = choice.get_metavar(param)
+    assert metavar == "[10|20]"
+
+
+def test_missing_message():
+    """Test missing value message shows canonical tokens."""
+    choice = click.Choice(Mode)
+    
+    @click.command()
+    @click.argument("mode", type=choice)
+    def cmd(mode):
+        pass
+    
+    param = cmd.params[0]
+    message = choice.get_missing_message(param)
+    assert "FAST" in message
+    assert "SAFE" in message
+
+
+def test_error_message_tokens():
+    """Test error message shows canonical tokens."""
+    choice = click.Choice(Mode)
+    
+    with pytest.raises(click.exceptions.BadParameter) as exc_info:
+        choice.convert("INVALID", None, None)
+    
+    assert "'FAST'" in str(exc_info.value)
+    assert "'SAFE'" in str(exc_info.value)
+
+
+def test_shell_complete_enum():
+    """Test shell completion for enum choices."""
+    choice = click.Choice(Mode)
+    
+    @click.command()
+    @click.option("--mode", type=choice)
+    def cmd(mode):
+        pass
+    
+    ctx = click.Context(cmd)
+    param = cmd.params[0]
+    
+    completions = choice.shell_complete(ctx, param, "")
+    assert len(completions) == 2
+    assert completions[0].value == "FAST"
+    assert completions[1].value == "SAFE"
+    
+    completions = choice.shell_complete(ctx, param, "F")
+    assert len(completions) == 1
+    assert completions[0].value == "FAST"
+
+
+def test_shell_complete_case_insensitive():
+    """Test case-insensitive shell completion."""
+    choice = click.Choice(["Straße", "STRASSE"], case_sensitive=False)
+    
+    @click.command()
+    @click.option("--opt", type=choice)
+    def cmd(opt):
+        pass
+    
+    ctx = click.Context(cmd)
+    param = cmd.params[0]
+    
+    completions = choice.shell_complete(ctx, param, "STRASS")
+    values = [c.value for c in completions]
+    assert "Straße" in values
+    assert "STRASSE" in values
+
+
+def test_shell_complete_with_normalizer():
+    """Test shell completion with context normalizer."""
+    @click.command()
+    @click.option("--opt", type=click.Choice(["read_only"]))
+    def cmd(opt):
+        pass
+    
+    ctx = click.Context(cmd, token_normalize_func=lambda x: x.replace("-", "_"))
+    param = cmd.params[0]
