+    assert "SAFE" in help_record[1]
+
+
+def test_to_info_dict():
+    """Test to_info_dict exposes original objects."""
+    choice = click.Choice(Mode)
+    info = choice.to_info_dict()
+    
+    assert "choices" in info
+    assert info["choices"] == [Mode.FAST, Mode.SAFE]
+
+
