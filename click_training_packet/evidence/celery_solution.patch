+"""Tests matching the exact requirements from problem.txt."""
+
+import enum
+import pytest
+import click
+from click.shell_completion import CompletionItem
+
+
+class Mode(enum.Enum):
+    """Example from problem.txt requirement."""
+    FAST = "fast-value"
+    SAFE = "safe-value"
+
+
+def test_requirement_example_1():
+    """With class Mode(Enum): FAST = "fast-value"; SAFE = "safe-value",
+    Choice(Mode).convert("FAST", None, None) returns Mode.FAST"""
+    choice = click.Choice(Mode)
+    result = choice.convert("FAST", None, None)
+    assert result == Mode.FAST
+    assert result is Mode.FAST
+
+
+def test_requirement_example_1_help():
+    """Option help lists [FAST|SAFE]."""
+    @click.command()
+    @click.option("--mode", type=click.Choice(Mode))
+    def cmd(mode):
+        pass
+    
+    param = cmd.params[0]
+    metavar = param.type.get_metavar(param)
+    assert metavar == "[FAST|SAFE]"
+
+
+def test_requirement_example_2():
+    """Choice([10, 20]).convert("20", None, None) returns the original integer 20."""
+    choice = click.Choice([10, 20])
+    result = choice.convert("20", None, None)
+    assert result == 20
+    assert type(result) is int
+
+
+def test_requirement_example_3_convert():
+    """Choice(["Straße", "STRASSE"], case_sensitive=False) converts "strasse" to the first original choice."""
+    choice = click.Choice(["Straße", "STRASSE"], case_sensitive=False)
+    result = choice.convert("strasse", None, None)
+    assert result == "Straße"
+
+
+def test_requirement_example_3_complete():
+    """Completes "STRASS" to both "Straße" and "STRASSE"."""
+    choice = click.Choice(["Straße", "STRASSE"], case_sensitive=False)
+    
+    @click.command()
+    @click.option("--opt", type=choice)
+    def cmd(opt):
+        pass
+    
+    ctx = click.Context(cmd)
+    param = cmd.params[0]
+    
+    completions = choice.shell_complete(ctx, param, "STRASS")
+    values = [c.value for c in completions]
+    assert len(values) == 2
+    assert "Straße" in values
+    assert "STRASSE" in values
+
+
+def test_requirement_example_4():
+    """With a context normalizer that replaces '-' with '_',
+    Choice(["read_only"]) accepts "read-only" and completes "read-" to "read_only"."""
+    choice = click.Choice(["read_only"])
+    
+    @click.command()
+    @click.option("--opt", type=choice)
+    def cmd(opt):
+        pass
+    
+    ctx = click.Context(cmd, token_normalize_func=lambda x: x.replace("-", "_"))
+    param = cmd.params[0]
+    
+    result = choice.convert("read-only", None, ctx)
+    assert result == "read_only"
+    
+    completions = choice.shell_complete(ctx, param, "read-")
+    assert len(completions) == 1
+    assert completions[0].value == "read_only"
+
+
+def test_finite_iterable_consumption():
+    """Requirement 1: Choice accepts any finite iterable, including one-shot generator.
+    Consume the iterable once during construction."""
+    def gen():
+        yield 1
+        yield 2
+    
+    choice = click.Choice(gen())
+    
+    assert choice.convert("1", None, None) == 1
+    assert choice.convert("2", None, None) == 2
+
+
+def test_enum_iteration_no_aliases():
+    """Requirement 1: An Enum class follows ordinary Python enum iteration,
+    so aliases are not added separately."""
+    class Status(enum.Enum):
+        PENDING = 1
+        WAITING = 1
+    
+    choice = click.Choice(Status)
+    
+    assert len(choice.choices) == 1
+    assert choice.choices[0] == Status.PENDING
+
+
+def test_canonical_token_enum():
+    """Requirement 2: canonical token is .name for enum.Enum member."""
+    choice = click.Choice(Mode)
+    
+    assert choice._get_canonical_token(Mode.FAST) == "FAST"
+    assert choice._get_canonical_token(Mode.SAFE) == "SAFE"
+
+
+def test_canonical_token_str_enum():
+    """Requirement 2: .name even for str subclass enum."""
+    class StrMode(str, enum.Enum):
+        READ = "read-mode"
+    
+    choice = click.Choice(StrMode)
+    assert choice._get_canonical_token(StrMode.READ) == "READ"
+
+
