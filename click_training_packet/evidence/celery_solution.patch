+
+
+def test_shell_complete_dedup_tokens():
+    """Test shell completion deduplicates identical canonical tokens."""
+    choice = click.Choice(["a", "a", "b"])
+    
+    @click.command()
+    @click.option("--opt", type=choice)
+    def cmd(opt):
+        pass
+    
+    ctx = click.Context(cmd)
+    param = cmd.params[0]
+    
+    completions = choice.shell_complete(ctx, param, "a")
+    assert len(completions) == 1
+    assert completions[0].value == "a"
+
+
+def test_enum_default_display():
+    """Test that enum defaults display as canonical tokens in help."""
+    @click.command()
+    @click.option("--mode", type=click.Choice(Mode), default=Mode.FAST, show_default=True)
+    def cmd(mode):
+        pass
+    
+    ctx = click.Context(cmd)
+    help_record = cmd.params[0].get_help_record(ctx)
